# ── Required ──────────────────────────────────────────────────────────────────
# Generate strong random keys for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=your-secret-key-here-change-this
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Neon, Supabase, or Railway.
# Example Neon: postgresql://user:pass@ep-xx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Example Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Flutter app's domains or *)
ALLOWED_ORIGINS=*

# ── Vercel auto-injects ───────────────────────────────────────────────────────
# VERCEL_URL is set automatically by Vercel to the deployment URL
# FLASK_ENV=production
